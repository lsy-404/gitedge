{
  "name": "gitedge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev-stack.sh",
    "build": "npm run build:web && npm run build:git",
    "build:web": "npm --prefix apps/web run build",
    "build:git": "wrangler deploy --dry-run --config workers/git/wrangler.jsonc --outdir work/dry-run-git",
    "preview": "npm --prefix apps/web run dev -- --host 127.0.0.1",
    "deploy": "node scripts/deploy-stack.mjs",
    "deploy:dry-run": "node scripts/deploy-stack.mjs --dry-run",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:auth": "vitest run --config vitest.config.ts test/auth.worker.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:web": "npm --prefix apps/web test",
    "types:generate": "wrangler types --config workers/git/wrangler.jsonc worker-configuration.d.ts",
    "types:generate:limits": "wrangler types --config workers/limits/wrangler.jsonc workers/limits/worker-configuration.d.ts",
    "typecheck": "npm run typecheck:git && npm run typecheck:services && npm run typecheck:gateway",
    "typecheck:git": "npm run types:generate && tsc -p workers/git/tsconfig.json --noEmit",
    "typecheck:services": "npm run types:generate:limits && tsc --noEmit -p workers/auth/tsconfig.json && tsc --noEmit -p workers/forge/tsconfig.json && tsc --noEmit -p workers/limits/tsconfig.json",
    "typecheck:gateway": "tsc --noEmit -p workers/gateway/tsconfig.json",
    "cf-typegen": "npm run types:generate",
    "db:generate:repo": "drizzle-kit generate --config drizzle-repo-do.config.ts",
    "db:generate:d1": "drizzle-kit generate --config drizzle-d1.config.ts",
    "db:generate": "npm run db:generate:repo && npm run db:generate:d1",
    "db:migrate": "wrangler d1 migrations apply gitedge --remote --config workers/auth/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply gitedge --local --persist-to .wrangler/state --config workers/auth/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.4",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "cf": "^1.0.0-beta.10",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.7.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "domhandler": "^6.0.1",
    "drizzle-orm": "^0.45.1",
    "highlight.js": "^11.11.1",
    "hono": "^4.12.18",
    "htmlparser2": "^12.0.0",
    "isomorphic-git": "^1.42.6",
    "lucide-react": "^1.7.0",
    "marked": "^18.0.3",
    "memfs": "^4.80.0",
    "openid-client": "^6.8.4",
    "pako": "^2.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  }
}
