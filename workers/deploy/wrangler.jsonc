{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitedge-deploy",
  "account_id": "df4481f3ce1fa0394b4617442a97d147",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "services": [{ "binding": "GIT", "service": "gitedge-git" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitedge",
      "database_id": "c9a00d9d-db41-494e-b096-55b8b6bfe3a9",
    },
  ],
  "observability": { "enabled": true },
}
