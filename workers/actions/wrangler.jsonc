{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitedge-actions",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "containers": [
    {
      "class_name": "ActionRun",
      "scheduling_policy": "durable_object",
      "images": {
        "runtime": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTION_RUNS",
        "class_name": "ActionRun"
      }
    ]
  },
  "exports": {
    "ActionRun": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitedge",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASE_ASSETS",
      "bucket_name": "gitedge-release-assets"
    }
  ],
  "services": [
    {
      "binding": "GIT",
      "service": "gitedge-git-artifacts"
    },
    {
      "binding": "FORGE",
      "service": "gitedge-forge"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "enable_containers": false
  }
}
