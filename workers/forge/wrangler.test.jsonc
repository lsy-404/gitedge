{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitedge-forge-tests",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "MERGE_QUEUE", "class_name": "MergeQueueDurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MergeQueueDurableObject"] }],
  "r2_buckets": [{ "binding": "RELEASE_ASSETS", "bucket_name": "gitedge-release-assets-tests" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitedge-forge-tests",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../migrations"
    }
  ]
}
