{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitedge-forge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitedge",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASE_ASSETS",
      "bucket_name": "gitedge-release-assets"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "* * * * *"]
  },
  "queues": {
    "producers": [{ "binding": "GITHUB_SYNC_QUEUE", "queue": "gitedge-github-sync" }],
    "consumers": [
      {
        "queue": "gitedge-github-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 5
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MERGE_QUEUE",
        "class_name": "MergeQueueDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MergeQueueDurableObject"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "gitedge",
      "remote": true
    }
  ],
  "services": [
    { "binding": "ACTIONS", "service": "gitedge-actions" },
    {
      "binding": "GIT",
      "service": "gitedge-git-artifacts"
    },
    {
      "binding": "AUTH",
      "service": "gitedge-auth"
    }
  ]
}
