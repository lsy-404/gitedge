{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitedge-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "../../apps/web/dist",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitedge",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "services": [
    {
      "binding": "AUTH",
      "service": "gitedge-auth"
    },
    {
      "binding": "FORGE",
      "service": "gitedge-forge"
    },
    {
      "binding": "GIT",
      "service": "gitedge-git-artifacts"
    },
    {
      "binding": "DEPLOY",
      "service": "gitedge-deploy"
    },
    {
      "binding": "ACTIONS",
      "service": "gitedge-actions"
    },
    {
      "binding": "MCP",
      "service": "gitedge-mcp"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "SharedRateLimitDurableObject",
        "script_name": "gitedge-limits"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimitDurableObject"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["RateLimitDurableObject"]
    }
  ],
  "vars": {
    "IP_RPM_LIMIT": "300",
    "PRIVATE_REPOSITORY_RESPONSE": "not_found"
  },
  "routes": [
    {
      "pattern": "gitedge.example.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
