{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gitedge-auth",
  "account_id": "df4481f3ce1fa0394b4617442a97d147",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "ALLOW_PUBLIC_SIGNUP": "true",
    "DEFAULT_USER_GROUP": "free",
    "SSO_PROVIDERS_JSON": "[{\"id\":\"voidcarve\",\"label\":\"Voidcarve Access\",\"protocol\":\"oidc\",\"issuer\":\"https://id.voidcarve.com\",\"clientId\":\"gitedge-production\",\"scopes\":[\"openid\",\"profile\",\"email\"],\"tokenAuthMethod\":\"client_secret_basic\",\"allowSignup\":true}]"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitedge",
      "database_id": "c9a00d9d-db41-494e-b096-55b8b6bfe3a9",
      "migrations_dir": "../../migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "gitedge",
      "remote": true
    }
  ]
}
